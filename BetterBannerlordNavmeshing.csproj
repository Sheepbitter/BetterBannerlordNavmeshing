<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>BetterBannerlordNavmeshing</AssemblyName>
    <RootNamespace>BetterBannerlordNavmeshing</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- TaleWorlds.Library/TaleWorlds.Engine guard their debug helpers with
         [Conditional("_RGL_KEEP_ASSERTS")], and the C# compiler evaluates that in
         the CALLING assembly. Without this symbol the compiler strips
         TaleWorlds.Engine.MBDebug.PostWarningLine, which is the only managed
         binding for the native post_warning_line sink - the sink the editor's Qt
         Console panel is actually drawn from (see the channel note at the top of
         NavMeshVisibleLog.cs). Defining it here only affects calls made from
         THIS assembly; the engine's own assemblies are unaffected. -->
    <DefineConstants>$(DefineConstants);_RGL_KEEP_ASSERTS</DefineConstants>

    <!-- Plain `dotnet build` targets the editor; client: -p:GameBinFolder=Win64_Shipping_Client -->
    <GameDir Condition="'$(GameDir)' == ''">D:\Secondary Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameDir>
    <GameBinFolder Condition="'$(GameBinFolder)' == ''">Win64_Shipping_wEditor</GameBinFolder>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(GameDir)\bin\$(GameBinFolder)\TaleWorlds.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine.AutoGenerated">
      <HintPath>$(GameDir)\bin\$(GameBinFolder)\TaleWorlds.Engine.AutoGenerated.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameDir)\bin\$(GameBinFolder)\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.DotNet">
      <HintPath>$(GameDir)\bin\$(GameBinFolder)\TaleWorlds.DotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.DotNet.AutoGenerated">
      <HintPath>$(GameDir)\bin\$(GameBinFolder)\TaleWorlds.DotNet.AutoGenerated.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(GameDir)\bin\$(GameBinFolder)\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameDir)\bin\$(GameBinFolder)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade.AutoGenerated">
      <HintPath>$(GameDir)\bin\$(GameBinFolder)\TaleWorlds.MountAndBlade.AutoGenerated.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.InputSystem">
      <HintPath>$(GameDir)\bin\$(GameBinFolder)\TaleWorlds.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(GameDir)\bin\$(GameBinFolder)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.LinQuick">
      <HintPath>$(GameDir)\bin\$(GameBinFolder)\TaleWorlds.LinQuick.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Vendored DotRecast subset (net472 / C# 7.3 backport), shipped inside this single DLL.
       The SDK default glob would already pick these up; the explicit Remove/Include pair makes the
       vendoring obvious and keeps a single source of truth. See ThirdParty/DotRecast/NOTICE.md. -->
  <ItemGroup>
    <Compile Remove="ThirdParty\DotRecast\**\*.cs" />
    <Compile Include="ThirdParty\DotRecast\**\*.cs" />
  </ItemGroup>

  <!-- Deploy the built assembly into the module's bin folder for this variant. -->
  <Target Name="DeployToModule" AfterTargets="Build">
    <PropertyGroup>
      <ModuleBinDir>$(GameDir)\Modules\BetterBannerlordNavmeshing\bin\$(GameBinFolder)</ModuleBinDir>
    </PropertyGroup>
    <MakeDir Directories="$(ModuleBinDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModuleBinDir)" />
  </Target>

</Project>
